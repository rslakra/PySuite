# PyCore — Justfile (run from PyCore/)

venv_name := "venv"
venv_pip := "./" + venv_name + "/bin/pip"
venv_python := "./" + venv_name + "/bin/python"


default:
    @just --list --unsorted

setup-venv:
    @printf "\033[36mCreating PyCore virtual environment...\033[0m\n"
    python3 -m venv {{venv_name}}
    @printf "\033[32m✓ Virtual environment created in ./{{venv_name}}\033[0m\n"
    @echo ""
    @printf "\033[33mActivate with:\033[0m source {{venv_name}}/bin/activate\n"

install-packages:
    @printf "\033[36mInstalling PyCore (editable) and dependencies...\033[0m\n"
    {{venv_pip}} install --upgrade pip
    {{venv_pip}} install -e .
    @printf "\033[32m✓ Installed pycore from pyproject.toml (src layout)\033[0m\n"

clean:
    @printf "\033[33mRemoving PyCore virtual environment...\033[0m\n"
    rm -rf {{venv_name}}
    @printf "\033[32m✓ Virtual environment removed\033[0m\n"

# ── Document converter (core.cli) ─────────────────────────────────────────────

list:
    {{venv_python}} -m core.cli --list

convert *ARGS:
    {{venv_python}} -m core.cli {{ARGS}}

convert-to input format:
    {{venv_python}} -m core.cli -i "{{input}}" "{{format}}"

cli-help:
    {{venv_python}} -m core.cli -h

# ── Office tooling (office.main) ──────────────────────────────────────────────

office *ARGS:
    {{venv_python}} -m office.main {{ARGS}}

# ── Core library demos ────────────────────────────────────────────────────────

time-demo:
    {{venv_python}} -m core.datetime.time

test:
    {{venv_python}} -m pytest tests/ -v

help:
    @printf "\033[1m\033[34mPyCore commands (run from PyCore/):\033[0m\n"
    @echo ""
    @printf "\033[33mEnvironment:\033[0m\n"
    @printf "\033[36m  just setup-venv\033[0m              - Create venv/\n"
    @printf "\033[36m  just install-packages\033[0m        - pip install -e . (src layout)\n"
    @printf "\033[36m  just clean\033[0m                   - Remove venv/\n"
    @echo ""
    @printf "\033[33mDocument converter:\033[0m\n"
    @printf "\033[36m  just list\033[0m                    - Supported conversions\n"
    @printf "\033[36m  just convert -i FILE pdf\033[0m           - Convert to a format\n"
    @printf "\033[36m  just convert -i FILE -f pdf\033[0m         - Same, with --format flag\n"
    @printf "\033[36m  just convert -i FILE --out OUT\033[0m    - Explicit output path\n"
    @printf "\033[36m  just convert-to FILE md\033[0m           - Shorthand: input + format\n"
    @printf "\033[36m  just cli-help\033[0m                - core.cli help\n"
    @echo ""
    @printf "\033[33mOffice tooling:\033[0m\n"
    @printf "\033[36m  just office ARGS...\033[0m          - office.main (export, roster, …)\n"
    @echo ""
    @printf "\033[33mCore library:\033[0m\n"
    @printf "\033[36m  just time-demo\033[0m               - UTC/TAI leap-second demo\n"
    @printf "\033[36m  just test\033[0m                    - pytest tests/\n"
    @echo ""
    @printf "\033[33mFrom repo root:\033[0m \033[36mjust pycore <command>\033[0m\n"
    @echo ""
