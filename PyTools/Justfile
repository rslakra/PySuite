# PyTools — Justfile (run from PyTools/)

venv_name := "venv"
venv_pip := "./" + venv_name + "/bin/pip"
venv_python := "./" + venv_name + "/bin/python"


default:
    @just --list --unsorted

setup-venv:
    python3 -m venv {{venv_name}}

install-packages:
    {{venv_pip}} install --upgrade pip
    {{venv_pip}} install -e .
    @printf "\033[32m✓ Installed pytools (src layout)\033[0m\n"

clean:
    rm -rf {{venv_name}}

index:
    {{venv_python}} -c "from pytools import PROJECT_INDEX; print('\\n'.join(f'{k} -> {v[0]}/{v[1]}' for k,v in sorted(PROJECT_INDEX.items())))"

help:
    @printf "\033[1mPyTools commands:\033[0m\n"
    @echo "  just install-packages   pip install -e ."
    @echo "  just index              print migration map"
