PYTHON ?= python3
ROOT := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
VENV := $(ROOT).venv
PY := $(VENV)/bin/python
PIP := $(VENV)/bin/pip
PACKAGE := $(shell $(PYTHON) -c "import pathlib,re; t=pathlib.Path('$(ROOT)pyproject.toml').read_text(); print(re.search(r'^name = \"([^\"]+)\"', t, re.M).group(1))")
VERSION_FILE := $(ROOT)VERSION
COMMENT ?= broken release

# The version is version.sh applied to this repo's commit count (see version.sh for the rules),
# so every new commit gives a new, higher version. Override with: make build VERSION=1.2.3
ifeq ($(origin VERSION),undefined)
VERSION_SOURCE := git
VERSION := $(shell bash $(ROOT)version.sh "$$(git -C $(ROOT) rev-list --count HEAD 2>/dev/null)" 2>/dev/null)
else
VERSION_SOURCE := manual
endif

.DEFAULT_GOAL := help

.PHONY: help setup install build test check deploy-testpypi deploy yank yank-testpypi install-wheel rebuild clean clean-all version version-file _require-venv _require-clean

help: ## Show available commands
	@echo "PyCrux ($(PACKAGE))"
	@echo ""
	@echo "Usage: make [target]"
	@echo ""
	@grep -E '^[a-zA-Z0-9_-]+:.*##' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*## "}; {printf "  \033[36m%-18s\033[0m %s\n", $$1, $$2}'

setup: version-file ## Create .venv and install this package in editable mode with dev extras
	$(PYTHON) -m venv $(VENV)
	$(PIP) install --upgrade pip
	$(PIP) install -e ".[dev]"
	@echo "Setup complete. Activate with: source .venv/bin/activate"

install: setup ## Alias for setup

version-file: ## Generate the VERSION file (from version.sh and the git commit count)
	@test -n "$(VERSION)" || { echo "Cannot determine the version (needs a git repo with commits). Pass VERSION=x.y.z"; exit 1; }
	@if [ "$(VERSION_SOURCE)" = "git" ] && [ "$$(git -C $(ROOT) rev-parse --is-shallow-repository 2>/dev/null)" = "true" ]; then \
		echo "Shallow git clone: the commit count (and so the version) would be wrong. Run 'git fetch --unshallow'."; exit 1; \
	fi
	@printf '%s\n' "$(VERSION)" > $(VERSION_FILE)
	@echo "Version: $(VERSION)"

build: version-file ## Build sdist and wheel into dist/ (version generated by version.sh)
	@$(MAKE) _require-venv
	rm -rf dist/ build/
	$(PY) -m build
	@echo "Artifacts:"
	@ls -1 dist/

test: ## Run unit tests against this source tree
	@$(MAKE) _require-venv
	$(PY) -m pytest

check: build ## Validate dist/ metadata with Twine
	$(PY) -m twine check dist/*

deploy-testpypi: _require-clean check ## Upload dist/ to TestPyPI
	$(PY) -m twine upload --repository testpypi dist/*

deploy: _require-clean check ## Upload dist/ to PyPI
	$(PY) -m twine upload dist/*

yank: ## Yank VERSION on PyPI so pip skips it unless that version is pinned
	@$(MAKE) _require-venv
	@echo "Yanking $(PACKAGE)==$(VERSION) on PyPI"
	$(PY) -m twine yank --comment "$(COMMENT)" $(PACKAGE) $(VERSION)

yank-testpypi: ## Yank VERSION on TestPyPI so pip skips it unless that version is pinned
	@$(MAKE) _require-venv
	@echo "Yanking $(PACKAGE)==$(VERSION) on TestPyPI"
	$(PY) -m twine yank --repository testpypi --comment "$(COMMENT)" $(PACKAGE) $(VERSION)

install-wheel: build ## Install the local wheel (does not use PyPI)
	$(PIP) install --force-reinstall dist/*.whl

rebuild: clean build ## Remove artifacts, then build

clean: ## Remove build, dist, egg-info, and pytest cache
	rm -rf dist/ build/ .pytest_cache/ htmlcov/ .coverage
	rm -rf src/*.egg-info *.egg-info
	find $(ROOT) -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
	find $(ROOT) -type f -name '*.py[co]' -delete 2>/dev/null || true

clean-all: clean ## clean, plus remove .venv
	rm -rf $(VENV)

version: ## Print the version the next build will get (generated by version.sh)
	@test -n "$(VERSION)" || { echo "Cannot determine the version (needs a git repo with commits). Pass VERSION=x.y.z"; exit 1; }
	@echo "$(VERSION)"

_require-venv:
	@test -x $(PY) || (echo "Run 'make setup' first." && exit 1)

# The version is the commit count, so a dirty tree would publish uncommitted code under the
# version of the last commit. Commit first, or override with ALLOW_DIRTY=1.
_require-clean:
	@if [ "$(VERSION_SOURCE)" = "git" ] && [ -z "$(ALLOW_DIRTY)" ] && [ -n "$$(git -C $(ROOT) status --porcelain 2>/dev/null)" ]; then \
		echo "Uncommitted changes: the version ($(VERSION)) is the commit count, so commit first (or ALLOW_DIRTY=1)."; exit 1; \
	fi
