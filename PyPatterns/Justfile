# PyPatterns — Justfile (run from PyPatterns/)

python := "python3"


# Default recipe — show available commands
default:
    @just --list --unsorted

# ── Pattern demos (stdlib only — no venv required) ────────────────────────────

# Run the Singleton demo (creational/singleton.py)
singleton:
    {{python}} creational/singleton.py

# Run any pattern module — e.g. just run creational/singleton.py
run module:
    {{python}} {{module}}

# List implemented pattern modules
list:
    @printf "Implemented patterns:\n"
    @printf "  creational/singleton.py  — Singleton (thread-safe)\n"
    @printf "\nPlaceholder packages:\n"
    @printf "  behavioral/\n"
    @printf "  structural/\n"

# Show help
help:
    @printf "\033[1m\033[34mPyPatterns commands (run from PyPatterns/):\033[0m\n"
    @echo ""
    @printf "\033[33mPattern demos:\033[0m\n"
    @printf "\033[36m  just singleton\033[0m               - Run Singleton demo\n"
    @printf "\033[36m  just run creational/singleton.py\033[0m - Run any module path\n"
    @printf "\033[36m  just list\033[0m                    - List patterns\n"
    @echo ""
    @printf "\033[33mFrom repo root:\033[0m \033[36mjust pypatterns <command>\033[0m\n"
    @echo ""
