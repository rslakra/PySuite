# Generic .gitignore. Learn more: https://www.atlassian.com/git/tutorials/saving-changes/gitignore
# The last matching rule wins, so the "Exceptions" section is kept at the end.

# OS files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Application/Installer Packages
*.app
*.exe
*.dmg

# Claude Code: personal settings (shared .claude/settings.json can be committed)
.claude/settings.local.json

# Editor swap and backup files
*.swp
*~

# Gradle
.gradle/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Java / JVM
*.class
*.jar
*.war
target/
bin/

# Local Databases
*.db
*.db-*

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Maven
.mvn/

# Native build output
*.o
*.obj

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# Node and other dependency directories
node_modules/
*.tsbuildinfo
*.tgz
vendor/
bower_components/

# Python: bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.cache/

# Python: packaging and build output
/VERSION
build/
dist/
out/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Python: virtual environments and local config
.venv/
venv/
env/
.env
.env.*
!.env.example

# Secrets: signing keys and certificates (.p12 is used for macOS signing), Kubernetes
*.pem
*.p12
*.pfx
*.crt
*.key
kubeconfig
secrets/

# STS
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# Tests, coverage and type checkers
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
*.coverage.*
*.cover
htmlcov/
coverage/
TEST*.xml

# Visual Studio
*.suo
*.ntvs*
*.njsproj
*.sln

# VS Code: personal editor settings stay local; shared launch/tasks/recommendations are committed
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/launch.json
!**/.vscode/tasks.json
*.vsix
.vscode-test/

# Temporary and backup files
*.tmp
*.bak

# Large media files
*.mp4
*.avi
*.flv
*.mov
*.wmv
*.tiff

# Exceptions: files the rules above would exclude but that must be committed.
# Keep this section last: in .gitignore the last matching rule wins.

# Gradle wrapper jar (excluded by *.jar above; ./gradlew and CI need it)
!**/gradle/wrapper/gradle-wrapper.jar
