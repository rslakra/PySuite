# PhotoMixer — Justfile (run from PhotoMixer/)

venv_name := "venv"
venv_pip := "./" + venv_name + "/bin/pip"
venv_python := "./" + venv_name + "/bin/python"


default:
    @just --list --unsorted

setup-venv:
    python3 -m venv {{venv_name}}
    @printf "\033[32m✓ Virtual environment created in ./{{venv_name}}\033[0m\n"

install-packages: setup-venv
    {{venv_pip}} install --upgrade pip
    {{venv_pip}} install -e .
    @printf "\033[32m✓ Installed photomixer (src layout)\033[0m\n"

# Alias for install-packages
setup: install-packages

clean:
    rm -rf {{venv_name}}

run background foreground *args:
    #!/usr/bin/env bash
    set -eu
    CMD="{{venv_python}} -m photomixer.cli --background \"{{background}}\" --foreground \"{{foreground}}\""
    for arg in {{args}}; do
        if [[ "$arg" == output=* ]]; then
            OUTPUT="${arg#output=}"
            CMD="$CMD --output \"$OUTPUT\""
        elif [[ "$arg" == blend_mode=* ]]; then
            BLEND_MODE="${arg#blend_mode=}"
            CMD="$CMD --blend-mode \"$BLEND_MODE\""
        elif [[ "$arg" == opacity=* ]]; then
            OPACITY="${arg#opacity=}"
            CMD="$CMD --opacity \"$OPACITY\""
        elif [[ "$arg" == bg_threshold=* ]]; then
            BG_THRESHOLD="${arg#bg_threshold=}"
            CMD="$CMD --bg-threshold \"$BG_THRESHOLD\""
        fi
    done
    eval "$CMD"

help:
    @printf "\033[1mPhotoMixer commands:\033[0m\n"
    @echo "  just install-packages   pip install -e ."
    @echo "  just run BG FG [options]  Blend two images"
    @echo "  just clean              Remove venv/"
